    <span class="logo-copy">
      <strong>Vihaan's Vision</strong>
      <small>A world where every child smiles</small>
    </span>
  </a>
  <nav>
    <a href="/">Home</a><a href="/events/">Print Play Lab</a><a href="/donate/">Donate</a><a href="/donation-events/" style="color:#2f6f9f">Donation Events</a><a href="/testimonials/">Testimonials</a><a href="/team/">Team</a><a href="/contact/">Contact Us</a>
