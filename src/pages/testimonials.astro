  <nav>
    <a href="/">Home</a><a href="/events/">Print Play Lab</a><a href="/donate/">Donate</a><a href="/donation-events/">Donation Events</a><a href="/testimonials/" style="color:#2f6f9f">Testimonials</a><a href="/team/">Team</a><a href="/contact/">Contact Us</a>
  </nav>
